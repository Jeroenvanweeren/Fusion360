{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Fusion 360 (FlattenCurveToPlane)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "justMyCode": false,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${env:HOME}/Library/Application Support/Autodesk/Autodesk Fusion 360/API/AddIns/FlattenCurveToPlane"
                }
            ],
            "preLaunchTask": "Deploy FlattenCurveToPlane to Fusion 360"
        }
    ]
}